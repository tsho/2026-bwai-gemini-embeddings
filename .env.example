# --- 既定: AI Studio の API キーで動かす ---
GEMINI_API_KEY="your-api-key"

# --- 任意: GCP Service Account + Vertex AI に切り替える ---
# クォータが厳しくて 429 に当たる場合は、以下を有効化して Vertex AI 経由に切り替える。
# (詳しい手順は README の「Vertex AI に切り替える」セクション参照)
# USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# --- 任意: vector store を LanceDB に切り替える ---
# 既定は in-memory list[dict] + pickle (db.pkl)。LanceDB に切り替えると
# 永続化と ANN を DB 側に任せられる (データは lance_db/ に置かれる)。
# USE_LANCE=true
